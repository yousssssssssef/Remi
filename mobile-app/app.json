{
  "expo": {
    "name": "Remi",
    "slug": "remi-cookbook",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remi-cookbook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/remi.icon",
      "bundleIdentifier": "com.remi.cookbook.independent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8E45C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.remi.cookbook.independent"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8E45C",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#1734BE",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Remi uses the camera to photograph food and read receipts, so you can add groceries without typing.",
          "photosPermission": "Remi opens your photos so you can add a food photo or a receipt you already took.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0B1030"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1,
              "supportsText": true
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.remi.cookbook.independent",
          "widgets": [
            {
              "name": "RemiRings",
              "displayName": "Remi rings",
              "description": "Today's Fuel, Protein and Fibre rings, calories left and your streak.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "initialLayout": "src/widgets/remi-rings.tsx"
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
